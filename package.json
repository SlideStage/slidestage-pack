{
  "name": "slidestage-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent skill — pack any HTML deck into a .stage container.",
  "scripts": {
    "fixtures": "node tests/build_fixtures.mjs",
    "test": "node tests/build_fixtures.mjs && node tests/run_tests.mjs",
    "detect": "node scripts/detect_framework.mjs",
    "pack": "node scripts/pack_stage.mjs",
    "verify": "node scripts/verify_stage.mjs",
    "render:ecosystem": "npx --yes --package=@slidestage/brand@latest slidestage-render-ecosystem -- --target=README.md --lang=zh",
    "check:ecosystem-readme": "npx --yes --package=@slidestage/brand@latest slidestage-render-ecosystem -- --target=README.md --lang=zh --check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@slidestage/spec": "^0.1.0",
    "@slidestage/core": "^0.1.1"
  },
  "optionalDependencies": {
    "playwright": "^1.60.0"
  }
}
